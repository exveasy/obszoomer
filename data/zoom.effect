uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_offset;
uniform float zoom;

sampler_state linear_clamp {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSZoom(VertData v)
{
    VertData o;
    o.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    o.uv = v.uv;
    return o;
}

float4 PSZoom(VertData v) : TARGET
{
    float2 original_uv = v.uv / zoom + uv_offset;
    return image.Sample(linear_clamp, original_uv);
}

technique Draw {
    pass {
        vertex_shader = VSZoom(v);
        pixel_shader = PSZoom(v);
    }
}
